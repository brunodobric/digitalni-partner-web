// Worker dashboarda (dp-nadzor). Objava: npx wrangler deploy (iz mape nadzor/).
// Javne vrijednosti su ovdje; tajne se postavljaju s "npx wrangler secret put":
//   NADZOR_KLJUC (obavezno), CF_API_TOKEN (Cloudflare analitika), RESEND_KEY i OBAVIJEST_NA (mail o upitu i upozorenja)
//   FISK_CITANJE_TOKEN (PDF računa i provjera certifikata, ključ servisa fisk-racun samo za čitanje)
//   IZVODI_IBAN, IZVODI_POSILJATELJI, IZVODI_PROSLIJEDI (izvodi iz banke mailom, vidi README)
// Mail: Zoho prosljeđuje izvodi@digitalnipartner.hr na izvodi@banka.digitalnipartner.hr, a Email Routing to šalje ovom Workeru (handler email).
// Pristup: Cloudflare Access (tim soft-cloud-4728) pušta samo Brunin mail; /upit je javan za obrazac na webu.
{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "dp-nadzor",
  "main": "src/index.js",
  "workers_dev": true,
  "preview_urls": false,
  "routes": [{ "pattern": "nadzor.digitalnipartner.hr", "custom_domain": true }],
  "compatibility_date": "2026-10-23",
  "rules": [{ "type": "Text", "globs": ["**/*.html"], "fallthrough": true }, { "type": "Data", "globs": ["**/*.png"], "fallthrough": true }],
  // 0 5 * * *: jutarnje prikupljanje pa upozorenja; 15 * * * *: upozorenja svaki sat (src/index.js, scheduled).
  "triggers": { "crons": ["0 5 * * *", "15 * * * *"] },
  "observability": { "enabled": true },
  "vars": {
    "SUPABASE_URL": "https://uzdqbuzgvtqfglujhgrm.supabase.co",
    "SUPABASE_KEY": "sb_publishable_8lbUKiiQdvSWOc-WoChqlw_AvfNU1ao",
    "KUVERTA_URL": "https://liomzksuolbwmefdueep.supabase.co",
    "KUVERTA_KEY": "sb_publishable_AuP-UIk1QpnRg0YIqv90ng_tvnbRybM",
    "DOZVOLJENI_IZVORI": "https://digitalnipartner.hr,https://www.digitalnipartner.hr,https://digitalni-partner-web.bruno-dobric32.workers.dev",
    "ACCESS_TIM": "soft-cloud-4728.cloudflareaccess.com",
    "ACCESS_AUD": "0144174a889f88854a0ca3a3fc3c2b7371be7369991dc0bb6566e324a3d45b77",
    "CF_ACCOUNT_ID": "5a0c6ede647e40ba9eaeb7459590aa8f"
  }
}
