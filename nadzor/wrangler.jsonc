// Worker dashboarda (dp-nadzor). Objava: npx wrangler deploy (iz mape nadzor/).
// Javne vrijednosti su ovdje; tajne se postavljaju s "npx wrangler secret put":
//   NADZOR_KLJUC (obavezno), CF_API_TOKEN (Cloudflare analitika), RESEND_KEY i OBAVIJEST_NA (mail o novom upitu)
// Pristup: Cloudflare Access (tim soft-cloud-4728) pušta samo Brunin mail; /upit je javan za obrazac na webu.
{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "dp-nadzor",
  "main": "src/index.js",
  "preview_urls": false,
  "routes": [{ "pattern": "nadzor.digitalnipartner.hr", "custom_domain": true }],
  "compatibility_date": "2026-10-23",
  "rules": [{ "type": "Text", "globs": ["**/*.html"], "fallthrough": true }],
  "triggers": { "crons": ["0 5 * * *"] },
  "observability": { "enabled": true },
